{
  "manifest_version": 3,
  "name": "MF Alarm Sound",
  "version": "2.0.0",
  "description": "Alerte sonore sur alarmes Overview. Attache à l’onglet actif.",
  "incognito": "spanning",
  "browser_specific_settings": {
    "gecko": {
      "id": "mf-alarm-sound@local.mohand",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MF Alarm Sound",
    "default_popup": "popup.html",
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sounds/alarm.wav",
        "sounds/boat-horn.wav",
        "sounds/boat-horn-far.wav",
        "sounds/air-horn.wav",
        "sounds/train-horn.wav",
        "sounds/police-siren.wav",
        "sounds/fire-siren.wav"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}
